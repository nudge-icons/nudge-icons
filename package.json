{
  "name": "nudge-icons-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:icons": "tsx scripts/check-icons.ts && tsx scripts/check-equivalents.ts",
    "preview": "tsx scripts/preview.ts",
    "build:icons": "tsx scripts/build-icons.ts",
    "lint": "eslint .",
    "typecheck": "pnpm build:icons && tsc --noEmit && pnpm -r typecheck",
    "test": "pnpm build:icons && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm build:icons && pnpm -r build && tsx scripts/check-treeshake.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@phosphor-icons/core": "2.1.1",
    "@tabler/icons": "3.50.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "heroicons": "2.2.0",
    "jsdom": "31.0.0",
    "lucide-static": "1.70.0",
    "material-symbols": "0.48.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
