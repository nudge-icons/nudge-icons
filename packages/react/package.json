{
  "name": "@nudge-icons/react",
  "version": "0.0.0",
  "description": "Animated line icons for React",
  "keywords": [
    "react",
    "icons",
    "animated-icons",
    "svg",
    "css-animation",
    "lucide"
  ],
  "homepage": "https://nudge-icons.github.io/nudge-icons/docs/getting-started",
  "bugs": {
    "url": "https://github.com/nudge-icons/nudge-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nudge-icons/nudge-icons.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "Dmytro Shyshko (https://github.com/dimon85)",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
