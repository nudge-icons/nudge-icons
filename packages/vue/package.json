{
  "name": "@nudge-icons/vue",
  "version": "0.1.0",
  "description": "Animated line icons for Vue",
  "keywords": [
    "vue",
    "icons",
    "animated-icons",
    "svg",
    "css-animation",
    "lucide"
  ],
  "homepage": "https://nudge-icons.github.io/nudge-icons/docs/getting-started",
  "bugs": {
    "url": "https://github.com/nudge-icons/nudge-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nudge-icons/nudge-icons.git",
    "directory": "packages/vue"
  },
  "license": "MIT",
  "author": "Dmytro Shyshko (https://github.com/dimon85)",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@vue/test-utils": "2.5.1",
    "tsdown": "0.23.7",
    "vue": "3.5.45"
  },
  "publishConfig": {
    "access": "public"
  }
}
