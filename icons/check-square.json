{
  "name": "check-square",
  "category": "interface",
  "tags": ["checkbox", "checked", "done", "task", "selected"],
  "since": "0.3.0",
  "equivalents": {
    "lucide": ["square-check", "check-square"],
    "tabler": ["square-check"],
    "phosphor": ["check-square"],
    "material": ["check_box"]
  },
  "animation": {
    "name": "draw",
    "description": "The tick draws itself inside the box",
