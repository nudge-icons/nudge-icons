    "motion": [
      {
        "part": "mark",
        "preset": "draw"
      }
    ]
  },
  "filled": {
    "animation": {
      "name": "pop",
      "description": "The badge pops up and settles",
      "parts": ["badge"],
      "motion": [
        {
          "part": "badge",
          "preset": "pulse",
          "scale": 1.12
        }
      ]
    }
  }
}
