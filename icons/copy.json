{
  "name": "copy",
  "category": "actions",
  "tags": ["duplicate", "clipboard", "paste", "clone"],
  "equivalents": {
    "lucide": ["copy"],
    "heroicons": ["document-duplicate"],
    "tabler": ["copy"],
    "phosphor": ["copy"],
    "material": ["content_copy"]
  },
  "animation": {
    "name": "stack",
    "description": "The front sheet slides onto the back one and returns",
    "parts": ["front"],
    "motion": [
      {
        "part": "front",
        "preset": "nudge",
        "x": -2,
        "y": -2
      }
    ]
  },
  "toggle": {
    "description": "A tick draws inside the front sheet, which gives a short jolt",
    "parts": ["check", "front"],
    "activeOnly": ["check"],
    "motion": [
      {
        "part": "check",
        "preset": "draw"
      },
      {
        "part": "front",
        "preset": "bump",
        "x": -1.5,
        "y": -1.5
      }
    ]
  }
}
