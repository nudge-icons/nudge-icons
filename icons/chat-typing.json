        "duration": 450
      },
      {
        "part": "second",
        "preset": "nudge",
        "y": -1.5,
        "duration": 450,
        "delay": 120
      },
      {
        "part": "third",
        "preset": "nudge",
        "y": -1.5,
        "duration": 450,
        "delay": 240
      }
    ]
  }
