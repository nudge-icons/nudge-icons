{
  "name": "chat-typing",
  "category": "status",
  "tags": ["typing", "thinking", "message", "reply", "dots"],
  "themes": ["ai"],
  "since": "0.2.0",
  "equivalents": {
    "lucide": ["message-square-more"],
    "heroicons": ["chat-bubble-left-ellipsis"],
    "tabler": ["message-dots"],
    "phosphor": ["chat-dots"]
  },
  "animation": {
    "name": "type",
