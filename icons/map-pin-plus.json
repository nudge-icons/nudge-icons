{
  "name": "map-pin-plus",
  "category": "actions",
  "tags": ["add-location", "new-place", "marker", "location", "address"],
  "since": "0.5.0",
  "equivalents": {
    "lucide": ["map-pin-plus"],
    "tabler": ["map-pin-plus"],
