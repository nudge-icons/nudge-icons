{
  "name": "phone-call",
  "category": "status",
  "tags": ["calling", "ringing", "telephone", "contact", "talk"],
  "since": "0.4.0",
  "equivalents": {
    "lucide": ["phone-call"],
    "tabler": ["phone-call"],
    "phosphor": ["phone-call"],
    "material": ["phone_in_talk"]
  },
  "animation": {
    "name": "ring",
