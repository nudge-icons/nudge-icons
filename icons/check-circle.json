{
  "name": "check-circle",
  "category": "status",
  "tags": ["success", "done", "complete", "verified"],
  "equivalents": {
    "lucide": ["circle-check", "check-circle"],
    "heroicons": ["check-circle"],
    "tabler": ["circle-check"],
    "phosphor": ["check-circle"],
    "material": ["check_circle"]
  },
  "animation": {
    "name": "draw",
    "description": "The tick draws itself inside the circle",
    "parts": ["mark"],
    "motion": [
      {
        "part": "mark",
        "preset": "draw"
      }
    ]
  },
  "filled": {
    "animation": {
      "name": "pop",
      "description": "The badge pops up and settles",
      "parts": ["badge"],
      "motion": [
        {
          "part": "badge",
          "preset": "pulse",
          "scale": 1.12
        }
      ]
    }
  }
}
